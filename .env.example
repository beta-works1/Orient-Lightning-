# Dedicated Orient Lighting Supabase project (do NOT reuse other apps)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres — optional for the Next.js app (storefront + admin use Supabase API keys).
# Still useful for local scripts (migrate/seed) and drizzle-kit.
# Use Transaction pooler (port 6543). Username MUST be postgres.<project-ref>
# Example: postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Single admin email allowed into /admin (must match Supabase Auth user)
ADMIN_EMAIL=admin@example.com

# Site
NEXT_PUBLIC_SITE_URL=https://orientlighting.com.pk
NEXT_PUBLIC_WHATSAPP_NUMBER=923001674368

# Store locator: npm run seed:dealers
# data/dealers.json includes verified:false placeholders for layout testing.
# Replace or remove placeholders before production.
