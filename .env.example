# Dedicated Orient Lighting Supabase project (do NOT reuse other apps)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres — optional for the Next.js app (storefront + admin use Supabase API keys).
# Still useful for local scripts (migrate/seed) and drizzle-kit.
# Use Transaction pooler (port 6543). Username MUST be postgres.<project-ref>
# Example: postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Single admin email allowed into /admin (must match Supabase Auth user)
ADMIN_EMAIL=admin@example.com

# Site
NEXT_PUBLIC_SITE_URL=https://orientlighting.com.pk
NEXT_PUBLIC_WHATSAPP_NUMBER=923001674368

# Storage (created by drizzle/0002 + 0003). Public buckets:
#   product-images  — admin product photos (max 5MB, JPG/PNG/WebP/GIF/AVIF)
#   catalogues      — site-wide + per-product PDFs (max 25MB)
# Uploads go to Storage via signed URLs; the Next.js app never needs S3 keys.

# Gemini chatbot (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional override if default model isn't available on your free tier
# GEMINI_MODEL=gemini-1.5-flash

# Partner form: rows always go to partner_applications (review at /admin/partners).
# Email to sales@ is optional and only runs when Gmail or a verified Resend sender is set.
#
# Gmail (Google Workspace App Password) — leave blank to skip mail:
GMAIL_USER=sales@orientlighting.pk
GMAIL_APP_PASSWORD=
#
# Optional Resend (verify orientlighting.com.pk; do NOT use onboarding@resend.dev):
RESEND_API_KEY=
RESEND_FROM=Orient Lighting <noreply@orientlighting.com.pk>
#
# PARTNER_NOTIFY_EMAIL=sales@orientlighting.pk
# Required to read or POST /api/email/health:
# EMAIL_HEALTH_SECRET=long-random-string

# Store locator: npm run seed:dealers
# data/dealers.json includes verified:false placeholders for layout testing.
# Replace or remove placeholders before production.
