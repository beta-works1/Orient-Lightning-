: 240, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/batten_ab66bc04-77f6-4f57-9f58-e722e89e2557.png?v=1769676958", "variant_ids": [34822239780997, 34822239813765, 40167121453189, 40882093097093, 40882093129861, 40882093162629, 41498302808197, 41498302840965, 41498302873733]}, "available": false, "price": "1820.00", "grams": 400, "compare_at_price": null, "position": 9, "product_id": 5234047320197, "created_at": "2026-01-23T15:42:41+05:00", "updated_at": "2026-07-17T22:39:52+05:00"}], "images": [{"id": 34720074596485, "created_at": "2026-01-29T13:55:57+05:00", "position": 1, "updated_at": "2026-01-29T13:55:58+05:00", "product_id": 5234047320197, "variant_ids": [34822239780997, 34822239813765, 40167121453189, 40882093097093, 40882093129861, 40882093162629, 41498302808197, 41498302840965, 41498302873733], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/batten_ab66bc04-77f6-4f57-9f58-e722e89e2557.png?v=1769676958", "width": 320, "height": 240}], "options": [{"name": "WATTS", "position": 1, "values": ["20 WATT 2FT", "40 WATT 4FT", "60 WATT 4FT"]}, {"name": "Color temperature", "position": 2, "values": ["DAY LIGHT 6500K", "WARM LIGHT 3000K", "NATURAL LIGHT 4000K"]}]}, {"id": 5236077330565, "title": "T5 SINGLE BATTEN SQ/RD", "handle": "ol-6-watt-t5-single-batten-round", "body_html": "<style>\np, li{\nfont-size: 13px;\n}\nspan{\nfont-size: 20px;\nfont-weight: 500px;\n}>\n</style>\n<p><span><b> Description </b></span></p>\n<p style=\"margin-top: 10px;\">ORIENT Lighting, T5, Battens provides silky Smooth bright light with a long life and significant energy savings up to 80%. With a smart and elegant design made with Aluminum for a wide useability with good heat sink for long life replacing out Old incandescent bulbs and fixtures</p>\n<ul>\n<li>High color rendering 75CRI for vivid colors</li>\n</ul>\n<p>The color rendering index (CRI) is used to describe the effect of a light source on color appearance. Natural outdoor light has a CRI of 100 and is used as the standard of comparison for any other light source. The CRI of Orient Lighting LED (Category) light bulbs is always higher than <b>75CRI</b> close to the sun's value, reflecting colors truly and naturally.</p>\n<ul>\n<li>Designed for the comfort of your eyes</li>\n</ul>\n<p>It's easy to see how harsh lighting can strain the eyes. Too bright, and you get the glare. Too soft and you experience flicker. Now you can gently light up your world with LEDs designed to go easy on the eyes, and create the perfect ambience for your home.</p>\n<ul>\n<li>Instant light when switched on</li>\n</ul>\n<p>No need to wait: Orient led Lighting <b> Battens </b> (provide their full level of brightness immediately upon switching on.</p>\n<ul>\n<li>Lasts up to 8 years</li>\n</ul>\n<p>With a lifetime of up to 18.000 hours (10 Hrs./day), this Orient Lighting LED <b> Battens </b> will ensure your desired atmosphere for up to 8 years. *</p>\n<ul>\n<li>Safe for any room and convenient to recycle</li>\n</ul>\n<p>Orient Lighting LED <b> Battens </b> contain absolutely no hazardous materials, making them safe for any room and convenient to recycle.</p>\n<ul>\n<li>Beautiful, switched on and off</li>\n</ul>\n<p>Light can have different color temperatures, indicated in units called Kelvin (K). Bulbs with a low value produce a warm, more cozy light, while those with a high Kelvin value, create a cool, more energizing light.</p>\n<ul>\n<li>Avoid the hassle of changing Lights</li>\n</ul>\n<p>The durable alternative to incandescent light bulbs, Orient Lighting LED <b> Battens </b> can be installed and forgotten about, maintaining their beautiful light beam for years and years to come.</p>\n<p><img src=\"https://cdn.shopify.com/s/files/1/0333/6745/7925/files/des_icon_img.png\"></p>\n<h2>Applications</h2>\n<ul>\n<li style=\"list-style-type: square;\">Home</li>\n<li style=\"list-style-type: square;\">Office</li>\n<li style=\"list-style-type: square;\">Malls</li>\n<li style=\"list-style-type: