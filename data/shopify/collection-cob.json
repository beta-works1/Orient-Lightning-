: false, "featured_image": {"id": 17722257866885, "product_id": 5234048172165, "position": 1, "created_at": "2021-02-02T16:08:09+05:00", "updated_at": "2021-02-02T16:08:09+05:00", "alt": null, "width": 2000, "height": 2000, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/products/OL-CS10B.jpg?v=1612264089", "variant_ids": [34822241124485, 34822241157253, 40886108356741, 40886108389509]}, "available": true, "price": "7254.00", "grams": 400, "compare_at_price": null, "position": 4, "product_id": 5234048172165, "created_at": "2024-08-29T15:50:01+05:00", "updated_at": "2026-07-17T22:39:58+05:00"}], "images": [{"id": 17722257866885, "created_at": "2021-02-02T16:08:09+05:00", "position": 1, "updated_at": "2021-02-02T16:08:09+05:00", "product_id": 5234048172165, "variant_ids": [34822241124485, 34822241157253, 40886108356741, 40886108389509], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/products/OL-CS10B.jpg?v=1612264089", "width": 2000, "height": 2000}], "options": [{"name": "Shape", "position": 1, "values": ["Round", "Square"]}, {"name": "Color temperature", "position": 2, "values": ["DAY LIGHT", "WARM LIGHT"]}]}, {"id": 7238920732805, "title": "Anti-Glare Adjustable LED Spot Light", "handle": "anti-glare-adjustable-led-spot-light", "body_html": "<p data-start=\"0\" data-end=\"61\"><strong data-start=\"0\" data-end=\"61\">Anti-Glare Adjustable LED Spot Light (Recessed Downlight)</strong></p>\n<p data-start=\"63\" data-end=\"402\">Enhance your interiors with this premium <strong data-start=\"104\" data-end=\"144\">Anti-Glare Adjustable LED Spot Light</strong>, designed to deliver focused illumination with maximum visual comfort. Featuring a deep-recessed light source and precision reflector, this spotlight minimizes glare while providing clean, controlled light\u2014ideal for modern residential and commercial spaces.</p>\n<p data-start=\"404\" data-end=\"705\">Its <strong data-start=\"408\" data-end=\"438\">tiltable adjustable design</strong> allows you to direct light exactly where it\u2019s needed, making it perfect for accent lighting, highlighting d\u00e9cor, retail displays, artwork, or architectural details. The sleek white finish blends seamlessly into ceilings, offering a refined and minimalist appearance.</p>\n<p data-start=\"707\" data-end=\"859\">Built with <strong data-start=\"718\" data-end=\"773\">high-quality materials and efficient LED technology</strong>, this spotlight ensures long life, low power consumption, and consistent performance.</p>\n<p data-start=\"861\" data-end=\"878\"><strong data-start=\"861\" data-end=\"878\">Key Features:</strong></p>\n<ul data-start=\"879\" data-end=\"1142\">\n<li data-start=\"879\" data-end=\"939\">\n<p data-start=\"881\" data-end=\"939\">Anti-glare deep recessed design for comfortable lighting</p>\n</li>\n<li data-start=\"940\" data-end=\"997\">\n<p data-start=\"942\" data-end=\"997\">Adjustable/tiltable head for directional illumination</p>\n</li>\n<li data-start=\"998\" data-end=\"1028\">\n<p data-start=\"1000\" data-end=\"1028\">Modern, clean white finish</p>\n</li>\n<li data-start=\"1029\" data-end=\"1064\">\n<p data-start=\"1031\" data-end=\"1064\">Energy-efficient LED technology</p>\n</li>\n<li data-start=\"1065\" data-end=\"1103\">\n<p data-start=\"1067\" data-end=\"1103\">Long lifespan with low maintenance</p>\n</li>\n<li data-start=\"1104\" data-end=\"1142\">\n<p data-start=\"1106\" data-end=\"1142\">Easy recessed ceiling installation</p>\n</li>\n</ul>\n<p data-start=\"1144\" data-end=\"1161\"><strong data-start=\"1144\" data-end=\"1161\">Applications:</strong></p>\n<ul data-start=\"1162\" data-end=\"1282\">\n<li data-start=\"1162\" data-end=\"1184\">\n<p data-start=\"1164\" data-end=\"1184\">Homes &amp; apartments</p>\n</li>\n<li data-start=\"1185\" data-end=\"1214\">\n<p data-start=\"1187\" data-end=\"1214\">Retail stores &amp; showrooms</p>\n</li>\n<li data-start=\"1215\" data-end=\"1246\">\n<p data-start=\"1217\" data-end=\"1246\">Offices &amp; commercial spaces</p>\n</li>\n<li data-start=\"1247\" data-end=\"1282\">\n<p data-start=\"1249\" data-end=\"1282\">Hotels, galleries &amp; restaurants</p>\n</li>\n</ul>\n<p data-start=\"1284\" data-end=\"1459\" data-is-last-node=\"\" data-is-only-node=\"\">A perfect combination of <strong data-start=\"1309\" data-end=\"1351\">style, performance, and visual comfort</strong>, this anti-glare spot light is an excellent choice for any space that demands precise and elegant lighting.</p>", "published_at": "2026-01-28T14:50:08+05:00", "created_at": "2026-01-28T14:50:06+05:00", "updated_at": "2026-07-17T22:39:58+05:00", "vendor": "ORIENT Lighting", "product_type": "Downlights", "tags": ["3 inch", "3 Watt", "3000K", "4 inch", "6500K", "COB", "DAY LIGHT", "DOWN LIGHT", "NATURAL LIGHT", "ORIENT", "WARM LIGHT"], "variants": [{"id": 41505622294661, "title": "White Color / 3Watt / 4000k", "option1": "White Color", "option2": "3Watt", "option3": "4000k", "sku": null, "requires_shipping": true, "taxable": true, "featured_image": {"id": 34715599929477, "product_id": 7238920732805, "position": 4, "created_at": "2026-01-28T14:44:56+05:00", "updated_at": "2026-01-29T14:03:35+05:00", "alt": null, "width": 1080, "height": 1350, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/AntiGlareWhiteRef.png?v=1769677415", "variant_ids": [41505622294661, 41505622327429, 41505622360197, 41505622392965]}, "available": true, "price": "540.00", "grams": 0, "compare_at_price": null, "position": 1, "product_id": 7238920732805, "created_at": "2026-01-28T14:50:07+05:00", "updated_at": "2026-07-17T22:39:58+05:00"}, {"id": 41505622327429, "title": "White Color / 3Watt / 3000k", "option1": "White Color", "option2": "3Watt", "option3": "3000k", "sku": null, "requires_shipping": true, "taxable": true, "featured_image": {"id": 34715599929477, "product_id": 7238920732805, "position": 4, "created_at": "2026-01-28T14:44:56+05:00", "updated_at": "2026-01-29T14:03:35+05:00", "alt": null, "width": 1080, "