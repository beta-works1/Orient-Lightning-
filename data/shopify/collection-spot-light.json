{"products": [{"id": 5234050302085, "title": "ADVANLUX LED STREET LIGHT", "handle": "60-watt-street-light-smd", "body_html": "<style>\np, li{\nfont-size: 13px;\n}\nspan{\nfont-size: 20px;\nfont-weight: 500px;\n}>\n</style>\n<p><span><b> Description </b></span></p>\n<h3 data-start=\"42\" data-end=\"76\"><strong data-start=\"46\" data-end=\"76\">Advanlux SLED Street Light</strong></h3>\n<p data-start=\"78\" data-end=\"397\">The <strong data-start=\"82\" data-end=\"112\">Advanlux SLED Street Light</strong> is a high-performance outdoor lighting solution designed to deliver powerful illumination, long service life, and reliable protection in demanding environments. Built with advanced LED technology and a robust housing, it is ideal for modern infrastructure and urban lighting projects.</p>\n<h4 data-start=\"399\" data-end=\"420\"><strong data-start=\"404\" data-end=\"420\">Key Features</strong></h4>\n<ul data-start=\"421\" data-end=\"1359\">\n<li data-start=\"421\" data-end=\"590\">\n<p data-start=\"423\" data-end=\"590\"><strong data-start=\"423\" data-end=\"458\">High-Efficiency LED Performance</strong><br data-start=\"458\" data-end=\"461\">Provides bright, uniform light distribution with excellent energy efficiency, reducing power consumption and operational costs.</p>\n</li>\n<li data-start=\"592\" data-end=\"774\">\n<p data-start=\"594\" data-end=\"774\"><strong data-start=\"594\" data-end=\"625\">Up to 10KV Surge Protection</strong><br data-start=\"625\" data-end=\"628\">Integrated surge protection safeguards the luminaire from voltage spikes and electrical surges, ensuring stable operation and extended lifespan.</p>\n</li>\n<li data-start=\"776\" data-end=\"950\">\n<p data-start=\"778\" data-end=\"950\"><strong data-start=\"778\" data-end=\"806\">Multiple Wattage Options</strong><br data-start=\"806\" data-end=\"809\">Available in <strong data-start=\"824\" data-end=\"853\">60W, 120W, 150W, and 200W</strong>, making it suitable for a wide range of applications\u2014from residential streets to major roadways.</p>\n</li>\n<li data-start=\"952\" data-end=\"1096\">\n<p data-start=\"954\" data-end=\"1096\"><strong data-start=\"954\" data-end=\"988\">Durable Die-Cast Aluminum Body</strong><br data-start=\"988\" data-end=\"991\">Strong, corrosion-resistant housing with efficient heat dissipation for reliable long-term performance.</p>\n</li>\n<li data-start=\"1098\" data-end=\"1236\">\n<p data-start=\"1100\" data-end=\"1236\"><strong data-start=\"1100\" data-end=\"1124\">Outdoor-Ready Design</strong><br data-start=\"1124\" data-end=\"1127\">Engineered to perform consistently in harsh weather conditions, making it ideal for continuous outdoor use.</p>\n</li>\n<li data-start=\"1238\" data-end=\"1359\">\n<p data-start=\"1240\" data-end=\"1359\"><strong data-start=\"1240\" data-end=\"1269\">Sleek &amp; Modern Appearance</strong><br data-start=\"1269\" data-end=\"1272\">Contemporary design that complements urban landscapes and architectural environments.</p>\n</li>\n</ul>\n<h4 data-start=\"1361\" data-end=\"1382\"><strong data-start=\"1366\" data-end=\"1382\">Applications</strong></h4>\n<ul data-start=\"1383\" data-end=\"1530\">\n<li data-start=\"1383\" data-end=\"1405\">\n<p data-start=\"1385\" data-end=\"1405\">Roads and highways</p>\n</li>\n<li data-start=\"1406\" data-end=\"1429\">\n<p data-start=\"1408\" data-end=\"1429\">Residential streets</p>\n</li>\n<li data-start=\"1430\" data-end=\"1465\">\n<p data-start=\"1432\" data-end=\"1465\">Industrial and commercial areas</p>\n</li>\n<li data-start=\"1466\" data-end=\"1495\">\n<p data-start=\"1468\" data-end=\"1495\">Parking lots and campuses</p>\n</li>\n<li data-start=\"1496\" data-end=\"1530\">\n<p data-start=\"1498\" data-end=\"1530\">Public infrastructure projects</p>\n</li>\n</ul>\n<p data-start=\"1532\" data-end=\"1693\"><strong data-start=\"1532\" data-end=\"1562\">Advanlux SLED Street Light</strong> combines efficiency, durability, and advanced protection\u2014making it a dependable choice for smart and sustainable outdoor lighting.</p>\n<p><img src=\"https://cdn.shopify.com/s/files/1/0333/6745/7925/files/des_icon_img.png\"></p>", "published_at": "2026-01-29T16:04:57+05:00", "created_at": "2021-01-07T10:47:18+05:00", "updated_at": "2026-07-17T22:40:17+05:00", "vendor": "Orient", "product_type": "Street Light", "tags": ["60 Watt", "6800K", "DAY LIGHT", "OL-STL60S", "ORIENT", "SMD", "STREET LIGHT"], "variants": [{"id": 41507121954949, "title": "DAY LIGHT / 120W", "option1": "DAY LIGHT", "option2": "120W", "option3": null, "sku": null, "requires_shipping": true, "taxable": false, "featured_image": {"id": 34720388415621, "product_id": 5234050302085, "position": 1, "created_at": "2026-01-29T16:01:10+05:00", "updated_at": "2026-01-29T16:01:22+05:00", "alt": null, "width": 500, "height": 500, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/AdvanLuxStreetLight1.png?v=1769684482", "variant_ids": [41507121954949, 41507122086021]}, "available": true, "price": "45500.00", "grams": 3300, "compare_at_price": null, "position": 1, "product_id": 5234050302085, "created_at": "2026-01-29T16:02:32+05:00", "updated_at": "2026-07-17T22:40:17+05:00"}, {"id": 41507122086021, "title": "Warm Light / 120W", "option1": "Warm Light", "option2": "120W", "option3": null, "sku": null, "requires_shipping": true, "taxable": false, "featured_image": {"id": 34720388415621, "product_id": 5234050302085, "position": 1, "created_at": "2026-01-29T16:01:10+05:00", "updated_at": "2026-01-29T16:01:22+05:00", "alt": null, "width": 500, "height": 500, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/AdvanLuxStreetLight1.png?v=1769684482", "variant_ids": [41507121954949, 41507122086021]}, "available": true, "price": "45500.00", "grams": 3300, "compare_at_price": null, "position": 2, "product_id": 5234050302085, "created_at": "2026-01-29T16:02:32+05:00", "updated_at": "2026-07-17T22:40:17+05:00"}], "images": [{"id": 34720388415621, "created_at": "2026-01