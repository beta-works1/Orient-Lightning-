 "updated_at": "2026-01-27T16:51:59+05:00", "alt": null, "width": 4096, "height": 4096, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/IMG_4663.jpg?v=1769514719", "variant_ids": [41503994183813, 41503994216581, 41503994249349, 41503994282117, 41503994314885, 41503994347653]}, "available": true, "price": "27100.00", "grams": 0, "compare_at_price": null, "position": 5, "product_id": 7238401261701, "created_at": "2026-01-27T16:58:31+05:00", "updated_at": "2026-07-17T22:40:17+05:00"}, {"id": 41503994347653, "title": "200 Watt / 3000k", "option1": "200 Watt", "option2": "3000k", "option3": null, "sku": "500000000449", "requires_shipping": true, "taxable": true, "featured_image": {"id": 34707921043589, "product_id": 7238401261701, "position": 1, "created_at": "2026-01-27T16:51:57+05:00", "updated_at": "2026-01-27T16:51:59+05:00", "alt": null, "width": 4096, "height": 4096, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/IMG_4663.jpg?v=1769514719", "variant_ids": [41503994183813, 41503994216581, 41503994249349, 41503994282117, 41503994314885, 41503994347653]}, "available": true, "price": "27100.00", "grams": 0, "compare_at_price": null, "position": 6, "product_id": 7238401261701, "created_at": "2026-01-27T16:58:31+05:00", "updated_at": "2026-07-17T22:40:17+05:00"}], "images": [{"id": 34707921043589, "created_at": "2026-01-27T16:51:57+05:00", "position": 1, "updated_at": "2026-01-27T16:51:59+05:00", "product_id": 7238401261701, "variant_ids": [41503994183813, 41503994216581, 41503994249349, 41503994282117, 41503994314885, 41503994347653], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/IMG_4663.jpg?v=1769514719", "width": 4096, "height": 4096}, {"id": 34707921010821, "created_at": "2026-01-27T16:51:57+05:00", "position": 2, "updated_at": "2026-01-27T16:51:58+05:00", "product_id": 7238401261701, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/54E3FEF1-EEC2-419E-9078-B87AD865728C.png?v=1769514718", "width": 1024, "height": 1024}, {"id": 34707920978053, "created_at": "2026-01-27T16:51:57+05:00", "position": 3, "updated_at": "2026-01-27T16:51:58+05:00", "product_id": 7238401261701, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/4A356AC0-762F-424D-8EE0-CE97901B92F8.png?v=1769514718", "width": 1024, "height": 1024}, {"id": 34707921076357, "created_at": "2026-01-27T16:51:57+05:00", "position": 4, "updated_at": "2026-01-27T16:51:58+05:00", "product_id": 7238401261701, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/IMG_4667.jpg?v=1769514718", "width": 1024, "height": 1024}], "options": [{"name": "Wattages", "position": 1, "values": ["100 Watt", "150 Watt", "200 Watt"]}, {"name": "Color temprature", "position": 2, "values": ["6500k", "3000k"]}]}, {"id": 5234050334853, "title": "ECO SERIES STREET LIGHT", "handle": "80-watt-street-light-smd", "body_html": "<style>\np, li{\nfont-size: 13px;\n}\nspan{\nfont-size: 20px;\nfont-weight: 500px;\n}>\n</style>\n<p><span><b> Description </b></span></p>\n<p><strong>Eco Series Street Light \u2013 Smart, Reliable &amp; Energy Efficient</strong></p>\n<p>The <strong>Eco Series Street Light</strong> is designed to provide clear, focused illumination exactly where it\u2019s needed \u2013 on the road. With a robust build, advanced optics, and efficient energy consumption, it ensures safer streets and reduced electricity costs. Built to last, it combines performance with durability, making it the ideal choice for modern urban and rural lighting.</p>\n<p><strong>Key Features:</strong></p>\n<ul>\n<li>\n<p><strong>Focused Street Illumination:</strong> Specially designed optics that direct light precisely on the road for maximum visibility and safety.</p>\n</li>\n<li>\n<p><strong>2.5kVA Surge Protection:</strong> Safeguards the light against sudden voltage spikes, ensuring uninterrupted operation.</p>\n</li>\n<li>\n<p><strong>Energy Efficient Lighting:</strong> High-performance LEDs deliver powerful brightness with up to 80% energy savings.</p>\n</li>\n<li>\n<p><strong>High Color Rendering (80+ CRI):</strong> Brings out natural, vivid colors for clearer night-time visibility.</p>\n</li>\n<li>\n<p><strong>IP66 Protection:</strong> Dust-tight and water-resistant, ensuring reliable performance in all weather conditions.</p>\n</li>\n<li>\n<p><strong>Long Operating Life:</strong> Up to <strong>18,000 hours</strong> of dependable lighting, reducing replacement frequency.</p>\n</li>\n<li>\n<p><strong>Instant On:</strong> Provides full brightness immediately without flicker or delay.</p>\n</li>\n<li>\n<p><strong>Eye Comfort Lighting:</strong> Reduces glare for drivers and pedestrians, enhancing road safety.</p>\n</li>\n<li>\n<p><strong>Eco-Friendly &amp; Safe:</strong> Free of hazardous substances and fully recyclable.</p>\n</li>\n<li>\n<p><strong>Durable Design:</strong> Strong housing with effective heat dissipation for stable, long-term performance.</p>\n</li>\n</ul>\n<p><strong>Built for Streets, Built to Last</strong><br>The <strong>Eco Series Street Light</strong> is tailored for <strong>roads, highways, housing societies, and public spaces</strong>, offering a combination of <strong>focused illumination, surge protection, and IP66 durability</strong>. It\u2019s a dependable choice for safe, sustainable, and cost-effective street lighting.</p>\n<p><strong>Eco Series \u2013 Lighting the Streets, Safely &amp; Efficiently.</strong></p>\n<p><img src=\"https://cdn.shopify.com/s/files/1/0333/6745/7925/files/des_icon_img.png\"></p>\n<h2>Applications</h2>\n<ul>\n<li style=\"list-style-type: square;\">Home</li>\n<li style=\"list-style-type: square;\">Office</li>\n<li style=\"list-style-type: square;\">Malls</li>\n<li style=\"list-style-type: square;\">Hospitality</li>\n<li style=\"list-style-type: square;\">Commercial Area</li>\n<li style=\"list-style-type: square;\">Shops</li>\n<li style=\"list-style-type: square;\">Other General Use</li>\n</ul>", "published_at": "2025-09-16T03:53:41+05:00", "created_at": "2021-01-07T10:47:19+05:00", "updated_at": "2026-07-17T22:40:17+05:00", "vendor": "Orient", "product_type": "Street Light", "tags": ["6800K", "80 Watt", "DAY LIGHT", "OL-STL80S", "ORIENT", "SMD", "STREET LIGHT"], "variants": [{"id": 41362551472261, "title": "50W", "option1": "50W", "option2": null, "option3": null, "sku": null, "requires_shipping": true, "taxable": false, "featured_image": null, "available": true, "price": "6670.00", "grams": 3600, "compare_at_price": null, "position": 1, "product_id": 5234050334853, "created_at": "2025-09-16T03:51:00+05:00", "updated_at": "2026-07-17T22:40:17+05:00"}, {"id": 41362553929861, "title": "100W", "option1": "100W", "option2": null, "option3": null, "sku": null, "requires_shipping": true, "taxable": false, "featured_image": null, "available": true, "price": "10420.00", "grams": 3600, "compare_at_price": null, "position": 2, "product_id": 5234050334853, "created_at": "2025-09-16T03:53:43+05:00", "updated_at": "2026-07-17T22:40:17+05:00"}], "images": [{"id": 34715847786629, "created_at": "2026-01-28T16:29:56+05:00", "position": 1, "updated_at": "2026-01-28T16:30:05+05:00", "product_id": 5234050334853, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/EVO_Lux_Street_Lights.png?v=1769599805", "width": 1080, "height": 1350}, {"id": 34294893609093, "created_at": "2025-09-16T03:45:33+05:00", "position": 2, "updated_at": "2026-01-28T16:30:05+05:00", "product_id": 5234050334853, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/16.jpg?v=1769599805", "width": 600, "height": 600}, {"id": 34294893576325, "created_at": "2025-09-16T03:45:33+05:00", "position": 3, "updated_at": "2026-01-28T16:30:05+05:00", "product_id": 5234050334853, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/4.jpg?v=1769599805", "width": 1024, "height": 598}, {"id": 34294893674629, "created_at": "2025-0