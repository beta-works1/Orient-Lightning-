les/1/0333/6745/7925/products/OL-PL48SQ_b0a5058d-2b68-4e09-bf6b-3648a2f1672d.jpg?v=1612264071", "width": 1000, "height": 1000}], "options": [{"name": "WATTS", "position": 1, "values": ["48 WATT"]}, {"name": "Color temperature", "position": 2, "values": ["DAY LIGHT 6500K", "WARM LIGHT 3000K"]}]}, {"id": 6807158456453, "title": "Moon light Series Recessed Panel", "handle": "15w-moon-light-led-panel-ol-apl24rd", "body_html": "<p><strong data-start=\"165\" data-end=\"212\">Moon Light Series LED Recessed Panel Lights</strong></p>\n<p data-start=\"214\" data-end=\"494\">The <strong data-start=\"218\" data-end=\"265\">Moon Light Series LED Recessed Panel Lights</strong> are designed to bring a sense of calm sophistication to modern interiors. Inspired by the soft, luminous glow of the moon, these panels deliver smooth, evenly diffused illumination that enhances spaces with understated elegance.</p>\n<p data-start=\"496\" data-end=\"827\">With a refined circular profile and an ultra-slim recessed design, the Moon Light Series blends seamlessly into ceilings, creating a clean and uncluttered look. Advanced LED technology ensures consistent brightness, low glare, and exceptional energy efficiency\u2014making it ideal for both ambient and functional lighting applications.</p>\n<p data-start=\"829\" data-end=\"968\">Available in a range of sizes and wattages, the Moon Light Series offers flexibility for diverse architectural and interior lighting needs.</p>\n<h4 data-start=\"970\" data-end=\"997\"><strong data-start=\"975\" data-end=\"997\">Available Variants</strong></h4>\n<ul data-start=\"998\" data-end=\"1073\">\n<li data-start=\"998\" data-end=\"1016\">\n<p data-start=\"1000\" data-end=\"1016\"><strong data-start=\"1000\" data-end=\"1016\">12W \u2013 3 Inch</strong></p>\n</li>\n<li data-start=\"1017\" data-end=\"1035\">\n<p data-start=\"1019\" data-end=\"1035\"><strong data-start=\"1019\" data-end=\"1035\">18W \u2013 4 Inch</strong></p>\n</li>\n<li data-start=\"1036\" data-end=\"1054\">\n<p data-start=\"1038\" data-end=\"1054\"><strong data-start=\"1038\" data-end=\"1054\">24W \u2013 6 Inch</strong></p>\n</li>\n<li data-start=\"1055\" data-end=\"1073\">\n<p data-start=\"1057\" data-end=\"1073\"><strong data-start=\"1057\" data-end=\"1073\">36W \u2013 8 Inch</strong></p>\n</li>\n</ul>\n<h4 data-start=\"1075\" data-end=\"1109\"><strong data-start=\"1080\" data-end=\"1109\">Color Temperature Options</strong></h4>\n<ul data-start=\"1110\" data-end=\"1293\">\n<li data-start=\"1110\" data-end=\"1166\">\n<p data-start=\"1112\" data-end=\"1166\"><strong data-start=\"1112\" data-end=\"1121\">3000K</strong> \u2013 Warm White for a soft, inviting ambience</p>\n</li>\n<li data-start=\"1167\" data-end=\"1231\">\n<p data-start=\"1169\" data-end=\"1231\"><strong data-start=\"1169\" data-end=\"1178\">4000K</strong> \u2013 Neutral White for balanced, natural illumination</p>\n</li>\n<li data-start=\"1232\" data-end=\"1293\">\n<p data-start=\"1234\" data-end=\"1293\"><strong data-start=\"1234\" data-end=\"1243\">6500K</strong> \u2013 Cool Daylight for bright, modern environments</p>\n</li>\n</ul>\n<h4 data-start=\"1295\" data-end=\"1318\"><strong data-start=\"1300\" data-end=\"1318\">Key Highlights</strong></h4>\n<ul data-start=\"1319\" data-end=\"1661\">\n<li data-start=\"1319\" data-end=\"1377\">\n<p data-start=\"1321\" data-end=\"1377\">Elegant circular recessed design with a premium finish</p>\n</li>\n<li data-start=\"1378\" data-end=\"1427\">\n<p data-start=\"1380\" data-end=\"1427\">Soft, uniform illumination with minimal glare</p>\n</li>\n<li data-start=\"1428\" data-end=\"1493\">\n<p data-start=\"1430\" data-end=\"1493\">High-efficiency LED technology for reduced energy consumption</p>\n</li>\n<li data-start=\"1494\" data-end=\"1544\">\n<p data-start=\"1496\" data-end=\"1544\">Long operational life with stable light output</p>\n</li>\n<li data-start=\"1545\" data-end=\"1586\">\n<p data-start=\"1547\" data-end=\"1586\">Easy and secure recessed installation</p>\n</li>\n<li data-start=\"1587\" data-end=\"1661\">\n<p data-start=\"1589\" data-end=\"1661\">Perfect for homes, offices, hospitality, retail, and commercial spaces</p>\n</li>\n</ul>\n<p data-start=\"1663\" data-end=\"1804\">The <strong data-start=\"1667\" data-end=\"1688\">Moon Light Series</strong> transforms everyday lighting into a refined visual experience\u2014where performance meets serenity and timeless design.</p>", "published_at": "2026-01-26T16:16:50+05:00", "created_at": "2023-03-22T16:07:03+05:00", "updated_at": "2026-07-17T22:39:57+05:00", "vendor": "ORIENT Lighting", "product_type": "Panels", "tags": ["Borderless", "CEILING PANEL LIGHT", "lighting", "Panels", "SMD"], "variants": [{"id": 40168180514949, "title": "Warm Light / 12 Watt 3Inch", "option1": "Warm Light", "option2": "12 Watt 3Inch", "option3": null, "sku": "500000000131", "requires_shipping": true, "taxable": true, "featured_image": {"id": 34687630606469, "product_id": 6807158456453, "position": 2, "created_at": "2026-01-26T15:08:33+05:00", "updated_at": "2026-01-26T15:51:23+05:00", "alt": null, "width": 1024, "height": 1536, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/IMG_4671.jpg?v=1769424683", "variant_ids": [40168180514949, 40168180547717, 40168180580485, 40214065086597, 40214065119365, 40214065152133, 41500955279493, 41500955312261, 41500955345029, 41500955377797, 41500955410565, 41500955443333]}, "available": true, "price": "450.00", "grams": 300, "compare_at_price": null, "position": 1, "product_id": 6807158456453, "created_at": "2023-03-22T16:07:03+05:00", "updated_at": "2026-07-17T22:39:57+05:00"}, {"id": 40214065086597, "title": "Warm Light / 18Watt 4Inch", "option1": "Warm Light", "option2": "18Watt 4Inch", "option3": null, "sku": "500000000161", "requires_shipping": true, "taxable": true, "featured_image": {"id": 34687630606469, "product_id": 6807158456453, "position": 2, "created_at": "2026-01-26T15:08:33+05:00", "updated_at": "2026-01-26T15:51: