09-16T03:14:56+05:00", "position": 1, "updated_at": "2025-09-16T03:21:51+05:00", "product_id": 5234050236549, "variant_ids": [34822246400133, 41362540658821, 41362540691589, 41362540920965, 41513138061445, 41513138094213, 41513138126981, 41513138159749], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/IMG_5733_1.jpg?v=1757974911", "width": 4096, "height": 4096}, {"id": 34294862184581, "created_at": "2025-09-16T03:14:57+05:00", "position": 2, "updated_at": "2025-09-16T03:21:51+05:00", "product_id": 5234050236549, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/CA1D0742-2DDA-481D-89F1-BF4FBEBB6C72.png?v=1757974911", "width": 1024, "height": 1024}, {"id": 34294862086277, "created_at": "2025-09-16T03:14:56+05:00", "position": 3, "updated_at": "2025-09-16T03:14:58+05:00", "product_id": 5234050236549, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/led-flood-light-at-construction-site.jpg?v=1757974498", "width": 1280, "height": 853}, {"id": 34294832464005, "created_at": "2025-09-16T02:51:42+05:00", "position": 4, "updated_at": "2025-09-16T02:51:43+05:00", "product_id": 5234050236549, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/flood-light-wattage_1.jpg?v=1757973103", "width": 1200, "height": 550}], "options": [{"name": "WATTAGE", "position": 1, "values": ["50W", "100W", "150W", "200W"]}, {"name": "Color Temprature", "position": 2, "values": ["Day light 6500K", "Warm light 3000k"]}]}, {"id": 6807168942213, "title": "EVO LUX LED FLOODLIGHT", "handle": "50-watt-led-floodlight-ol-fl50es", "body_html": "<h2><span><b> Description </b></span></h2>\n<p>\u00a0</p>\n<p><strong>Orient Lighting LED Flood Light \u2013 Bright, Durable &amp; Energy Efficient</strong></p>\n<p>The Orient Lighting LED Flood Light delivers powerful, silky-smooth illumination with up to 80% energy savings compared to traditional lighting. Built with high-quality aluminum housing and an advanced heat sink design, it ensures durability, efficient cooling, and long-lasting performance, making it the perfect choice for both indoor and outdoor applications.</p>\n<p><strong>Key Features:</strong></p>\n<ul>\n<li>\n<p><strong>Brilliant Light Output:</strong> Provides bright, uniform lighting that enhances visibility and ambience.</p>\n</li>\n<li>\n<p><strong>High Color Rendering (80+ CRI):</strong> Colors appear vivid and natural, close to sunlight, ensuring true-to-life tones.</p>\n</li>\n<li>\n<p><strong>Eye Comfort Design:</strong> Engineered to minimize glare and flicker, offering comfortable lighting for long hours.</p>\n</li>\n<li>\n<p><strong>Instant Full Brightness:</strong> Lights up immediately when switched on, with no delay.</p>\n</li>\n<li>\n<p><strong>Long Lifespan:</strong> With up to 18,000 hours of operation (approx. 8 years at 10 hours/day), it reduces the hassle of frequent replacements.</p>\n</li>\n<li>\n<p><strong>Safe &amp; Eco-Friendly:</strong> Contains no hazardous materials and is fully recyclable.</p>\n</li>\n<li>\n<p><strong>IP66 Rated Protection:</strong> Dust-tight and resistant to heavy water jets, making it ideal for outdoor use in all weather conditions.</p>\n</li>\n<li>\n<p><strong>Durable Construction:</strong> Aluminum body with efficient heat dissipation ensures consistent performance and reliability.</p>\n</li>\n</ul>\n<p><strong>Perfect for Outdoor &amp; Indoor Use</strong></p>\n<p>Thanks to its\u00a0<strong>IP66 waterproof rating</strong>, Orient Lighting LED Flood Light is built to withstand rain, dust, and harsh environments, making it suitable for gardens, driveways, stadiums, warehouses, and other demanding locations.</p>\n<p><strong>Reliable, Efficient &amp; Hassle-Free Lighting</strong><br>Replace outdated incandescent or halogen flood lights with Orient Lighting LED Flood Lights and enjoy superior brightness, reduced energy bills, and years of maintenance-free lighting.</p>\n<p><img src=\"https://cdn.shopify.com/s/files/1/0333/6745/7925/files/des_icon_img.png\"></p>\n<h2>Applications</h2>\n<ul>\n<li style=\"list-style-type: square;\">Home</li>\n<li style=\"list-style-type: square;\">Office</li>\n<li style=\"list-style-type: square;\">Malls</li>\n<li style=\"list-style-type: square;\">Hospitality</li>\n<li style=\"list-style-type: square;\">Commercial Area</li>\n<li style=\"list-style-type: square;\">Shops</li>\n<li style=\"list-style-type: square;\">Other General Use</li>\n</ul>", "published_at": "2024-09-26T13:39:30+05:00", "created_at": "2023-03-22T16:50:11+05:00", "updated_at": "2026-07-17T22:39:34+05:00", "vendor": "Orient", "product_type": "Flood Light", "tags": ["100 Watt", "3000K", "6500K", "DAY LIGHT", "ECONO", "FLOOD LIGHT", "OL-FL100ES", "ORIENT", "SMD", "WARM LIGHT"], "variants": [{"id": 40168259420293, "title": "30W / DAY LIGHT/ WARM LIGHT", "option1": "30W", "option2": "DAY LIGHT/ WARM LIGHT", "option3": null, "sku": "500000000261", "requires_shipping": true, "taxable": false, "featured_image": {"id": 34294829875333, "product_id": 6807168942213, "position": 2, "created_at": "2025-09-16T02:47:11+05:00", "updated_at": "2025-09-16T03:00:05+05:00", "alt": null, "width": 1024, "height": 1536, "src": "https://cdn.shopify.com/s/files/1/0333/6745/7925/files/5EE89DD1-0B8C-460E-9539-CE83D863619C.png?v=1757973605", "variant_ids": [40168259420293, 40945911660677, 40945911693445]}, "available": true, "price": "2440.00", "grams": 1500, "compare_at_price": null, "position": 1, "product_id": 6807168942213, "created_at": "2023-03-22T16:50:12+05:00", "updated_at": "2026-07-17T22:39:34+05:00"}, {"id": 40945911660677, "title": "50W / DAY LIGHT/ WARM LIGHT", "option1": "50W", "option2": "DAY LIGHT/ WARM LIGHT", "option3": null, "sku": "500000000262", "requires_shipping": true, "taxable": false, "featured_image": {"id": 34294829875333, "product_id": 6807168942213, "position": 2, "created_at": "2025-09-16T02:47:11+05:00", "updated_at": "2025-09-16T03:00:05+05:00", "alt": null, "widt